  "definitions": {
    "candidate_concept": "Expand each saved entity with patientphex.association._concepts: exclude NO case-insensitively, split semicolon identifiers, replace -1 by exact original entity text. _Document.samples creates a bag for every patient and eligible concept. This is reachability, not a correct span or correct patient assertion.",
    "association_unit": "Unique (pmc_id, patient_id, concept), using scorer _association_set. Identifiers are split as in the scorer; unmapped text is compared exactly.",
    "fn_candidate_absent": "Gold association not predicted and its concept absent from all eligible entities in that document.",
    "fn_candidate_present": "Gold association not predicted although its concept occurs in eligible entities in that document; the association decision did not retain it. This category does not establish why its score was low.",
    "fp_concept_in_gold_patient_elsewhere": "Predicted association is false but its concept occurs in at least one other patient gold association in that document.",
    "fp_concept_absent_gold_association": "Predicted association is false and the concept appears in no gold patient association in that document. It can still be a valid entity in non-patient/background text.",
    "cpu_tp_lost_new_candidate_present": "Association correctly predicted by CPU but absent from new output, with concept still reachable in new saved entities.",
    "new_tp_gained_cpu_candidate_present": "Association correctly predicted by new pipeline but absent from CPU output, with concept reachable in CPU saved entities.",
    "mention_fp": "Scorer positive units (offset,length,identifier); NO excluded and evaluation passages retained. Exact mapped matches are removed; each gold -1 consumes one exact-extent prediction, preferring literal -1, identically to _mention_counts.",
    "fp_same_extent_wrong_id": "Residual mention FP whose exact (offset,length) equals at least one positive gold entity extent. This includes surplus concepts at an already matched extent.",
    "fp_nongold_extent": "Residual mention FP with no exact positive gold extent. Disjoint from same_extent_wrong_id.",
    "fp_overlaps_positive_gold_extent": "Subset of fp_nongold_extent with any nonempty half-open character interval intersection with a positive gold entity. It does not require matching HPO ID, and cannot by itself attribute the FP to NER, KB, or a particular boundary mechanism."
  },
